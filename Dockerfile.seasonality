FROM python:3.11-slim

WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

ENV UV_SYSTEM_PYTHON=1

COPY pyproject.toml uv.lock README.md ./
COPY src/ src/

# Install only the seasonality group — skips the full ML stack (lightgbm, catboost,
# statsforecast, mlforecast, …). Then install the package itself without its heavy
# [project.dependencies] so REPO_ROOT resolves correctly via __file__.
RUN uv sync --only-group seasonality --no-install-project && \
    uv pip install --no-deps --editable .

COPY notebooks/seasonality.py notebooks/seasonality.py
COPY data/curated/ data/curated/

EXPOSE 2718

CMD ["uv", "run", "marimo", "run", "notebooks/seasonality.py", "--host", "0.0.0.0", "--port", "2718"]
