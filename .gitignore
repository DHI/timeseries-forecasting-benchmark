# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.python-version

# uv: lockfile IS committed for reproducible installs

# Data — raw is large (1 GB+) kept out of git; processed (~5 MB) is committed
data/raw/
# data/processed/ committed (small, enables instant CI and easy colleague onboarding)
data/cache/

# Results — regenerated by running the benchmark. Anchored to repo root so it doesn't
# also swallow docs/results/ (the committed, distilled scores for onboarding).
/results/
# Hand-made safety copies taken before an in-place merge. Anchored so it cannot swallow
# docs/results/partial/, whose tagged runs are the committed merge inputs.
/docs/results/backup/

# Run logs (nohup output from long unattended pilot runs)
/logs/
*.log

# Notebook checkpoints
.ipynb_checkpoints/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/
# Marimo notebook cache (auto-generated results)
notebooks/.cache/
notebooks/__marimo__/

# Static EDA site build output (scripts/build_site.py)
site/
_site/

web/node_modules/
web/dist/
# Local dev-server override for Lightning's proxy (which sends a lightning.ai Host that
# Vite 8 rejects). vite.config.ts is what ships to Pages; this one stays on the machine.
web/vite.preview.config.ts

.agents/
# Talk material kept locally (needed later, not for the repo)
docs/talk_app_intro.md
docs/talk_disclaimers.md

